NODE_ENV=development
PORT=3333

# PostgreSQL (docker-compose.yml usa estas mesmas credenciais)
DATABASE_URL=postgresql://error:error@localhost:5433/error

# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-de-48-bytes
JWT_EXPIRES_IN=30d

# Origens permitidas (separadas por vírgula)
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

LOG_LEVEL=info
